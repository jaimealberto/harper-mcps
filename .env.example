# harper-mcps — environment variables
# Copy this file to .env and fill in your values
# Source it before running Claude Code: source .env

# ── Obsidian MCP ──────────────────────────────────────────────────────────────
# Path to your Obsidian vault
OBSIDIAN_VAULT=/home/youruser/Obsidian

# ── WinRM MCP ────────────────────────────────────────────────────────────────
# Path to the WinRM hosts credentials file (chmod 600, NOT in git)
# Default: ~/.claude/winrm_hosts.json
# WINRM_HOSTS_CONFIG=/home/youruser/.claude/winrm_hosts.json

# ── OSINT MCP ────────────────────────────────────────────────────────────────
# Directory where OSINT reports will be saved
OSINT_VAULT=/home/youruser/osint-reports

# Path to theHarvester binary (auto-detected via PATH if not set)
# Useful if installed in a conda/venv environment:
# THEHARVESTER_BIN=/home/youruser/.conda/envs/osint/bin/theHarvester
